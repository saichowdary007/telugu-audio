{
  "manifest_version": 3,
  "name": "Telugu Audio Sync",
  "version": "0.1.0",
  "description": "Auto-sync Telugu audio clips to web video playback.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
